  "question": {
    "title": "SYNTHETIC REFERENCE: stationary supported blocks",
    "scenario": "",
    "blocks": [
      {
        "type": "image",
        "assetId": "question-support"
      },
      {
        "type": "paragraph",
        "text": "Two blocks are separately at rest on a horizontal table. The light block has mass $400\\,\\mathrm{g}$ and the heavy block has mass $600\\,\\mathrm{g}$. Use $g=9.81\\,\\mathrm{m\\,s^{-2}}$."
      }
    ],
    "totalMarks": 5,
    "estimatedMinutes": 8,
    "questionType": "structured"
  },
  "parts": [
    {
      "id": "a",
      "label": "(a)",
      "prompt": "Calculate the weight of the light block.",
      "marks": 1,
      "order": 0,
      "parentId": null
    },
    {
      "id": "b",
      "label": "(b)",
      "prompt": "For each block, write the vertical force equation and calculate the normal reaction.",
      "marks": 4,
      "order": 1,
      "parentId": null
    }
  ],
  "solutions": [
    {
      "partId": "a",
      "solution": "",
      "equationLatex": "",
      "teacherNotes": "",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Given: the light block mass is converted to SI units."
        },
        {
          "type": "math",
          "latex": "m_1=400\\,\\mathrm{g}=0.400\\,\\mathrm{kg}"
        }
      ],
      "steps": [
        {
          "number": 1,
          "explanation": "Calculate the weight.",
          "equationLatex": "W_1=m_1g=(0.400)(9.81)=\\boxed{3.92\\,\\mathrm{N}}",
          "working": "",
          "markingPoint": "Correct substitution and weight.",
          "marks": 1,
          "order": 0,
          "id": "step-1",
          "markingCode": "GJU1"
        }
      ]
    },
    {
      "partId": "b",
      "solution": "",
      "equationLatex": "",
      "teacherNotes": "",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Convention: take upward as positive. Each stationary block has zero vertical acceleration."
        },
        {
          "type": "math",
          "latex": "m_1=0.400\\,\\mathrm{kg},\\quad m_2=0.600\\,\\mathrm{kg}"
        }
      ],
      "steps": [
        {
          "number": 2,
          "explanation": "Resolve the forces on the light block.",
          "equationLatex": "",
          "working": "",
          "markingPoint": "Correct equilibrium equation for the light block.",
          "marks": 1,
          "order": 0,
          "blocks": [
            {
              "type": "image",
              "assetId": "answer-fbd-light"
            },
            {
              "type": "math",
              "latex": "\\sum F_y=N_1-W_1=0"
            }
          ],
          "id": "step-2",
          "markingCode": "G1"
        },
        {
          "number": 3,
          "explanation": "Calculate the light block normal reaction.",
          "equationLatex": "N_1=m_1g=\\boxed{3.92\\,\\mathrm{N}}",
          "working": "",
          "markingPoint": "Correct light block reaction.",
          "marks": 1,
          "order": 1,
          "id": "step-3",
          "markingCode": "JU1"
        },
        {
          "number": 4,
          "explanation": "Resolve the forces on the heavy block.",
          "equationLatex": "",
          "working": "",
          "markingPoint": "Correct equilibrium equation for the heavy block.",
          "marks": 1,
          "order": 2,
          "blocks": [
            {
              "type": "image",
              "assetId": "answer-fbd-heavy"
            },
            {
              "type": "math",
              "latex": "\\sum F_y=N_2-W_2=0"
            }
          ],
          "id": "step-4",
          "markingCode": "G1"
        },
        {
          "number": 5,
          "explanation": "Calculate the heavy block normal reaction.",
          "equationLatex": "N_2=(0.600)(9.81)=\\boxed{5.89\\,\\mathrm{N}}",
          "working": "",
          "markingPoint": "Correct heavy block reaction.",
          "marks": 1,
          "order": 3,
          "id": "step-5",
          "markingCode": "JU1"
        }
      ]
    }
