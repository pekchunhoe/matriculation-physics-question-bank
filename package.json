{
  "name": "matriculation-physics-question-bank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:browser:server": "tsx scripts/browser-server.ts",
    "db:check": "tsx scripts/check-db.ts",
    "schema:generate": "tsx scripts/export-schema.ts",
    "schema:check": "tsx scripts/export-schema.ts --check",
    "api:check": "tsx scripts/check-vercel-api.ts",
    "api:esm:check": "tsx scripts/check-api-esm.ts",
    "storage:check": "tsx --test tests/storage.test.ts",
    "auth:check": "tsx --test tests/auth.test.ts",
    "auth:migrate": "tsx scripts/auth-admin.ts migrate",
    "auth:bootstrap": "tsx scripts/auth-admin.ts bootstrap",
    "auth:revoke": "tsx scripts/auth-admin.ts revoke"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.1",
    "express": "^5.1.0",
    "katex": "^0.19.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "saxes": "^6.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.3",
    "@types/katex": "^0.16.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "axe-core": "^4.14.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4"
  }
}
