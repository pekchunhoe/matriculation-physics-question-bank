{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "question": {
      "type": "object",
      "properties": {
        "questionCode": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{2,79}$"
        },
        "topicId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "subtopicId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "scenario": {
          "type": "string",
          "maxLength": 30000
        },
        "blocks": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "paragraph"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 30000
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "math"
                  },
                  "latex": {
                    "type": "string",
                    "maxLength": 30000
                  }
                },
                "required": [
                  "type",
                  "latex"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "assetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "type",
                  "assetId"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "difficultyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "questionType": {
          "type": "string",
          "enum": [
            "structured",
            "multiple_choice",
            "short_answer",
            "essay"
          ]
        },
        "totalMarks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "estimatedMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewing",
            "approved",
            "retired"
          ]
        },
        "containsDiagram": {
          "type": "boolean"
        },
        "containsGraph": {
          "type": "boolean"
        },
        "containsFbd": {
          "type": "boolean"
        }
      },
      "required": [
        "questionCode",
        "topicId",
        "subtopicId",
        "title",
        "scenario",
        "difficultyId",
        "questionType",
        "totalMarks",
        "estimatedMinutes",
        "status",
        "containsDiagram",
        "containsGraph",
        "containsFbd"
      ],
      "additionalProperties": false
    },
    "parts": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "prompt": {
            "type": "string",
            "maxLength": 30000
          },
          "marks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "blocks": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "paragraph"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 30000
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "math"
                    },
                    "latex": {
                      "type": "string",
                      "maxLength": 30000
                    }
                  },
                  "required": [
                    "type",
                    "latex"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "image"
                    },
                    "assetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "type",
                    "assetId"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "label",
          "prompt",
          "marks",
          "order",
          "parentId"
        ],
        "additionalProperties": false
      }
    },
    "solutions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "partId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "blocks": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "paragraph"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 30000
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "math"
                    },
                    "latex": {
                      "type": "string",
                      "maxLength": 30000
                    }
                  },
                  "required": [
                    "type",
                    "latex"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
