            ]
          },
          "text": {
            "type": "string",
            "maxLength": 30000
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "partId",
          "text",
          "order"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "partId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "illustration",
              "physics_diagram",
              "fbd",
              "graph",
              "vector_diagram",
              "circuit_diagram",
              "answer_diagram",
              "reference_image",
              "original_pdf",
              "question_pdf",
              "answer_pdf"
            ]
          },
          "importMetadata": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "question_diagram",
                  "answer_diagram",
                  "free_body_diagram",
                  "graph",
                  "circuit_diagram",
                  "table_image",
                  "other_visual"
                ]
              },
              "caption": {
                "type": "string",
                "maxLength": 1000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "role",
              "sha256",
              "byteLength"
            ],
            "additionalProperties": false
          },
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "alt": {
            "type": "string",
            "maxLength": 1000
          },
          "mime": {
            "type": "string",
            "enum": [
              "image/svg+xml",
              "image/png",
              "image/jpeg",
              "image/webp",
              "application/pdf"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "partId",
          "kind",
          "url",
          "alt",
          "mime",
          "order"
        ],
        "additionalProperties": false
      }
    },
    "tags": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    }
