  "required": [
    "schemaVersion",
    "question",
    "parts",
    "solutions",
    "hints",
    "assets",
    "tags"
  ],
  "additionalProperties": false,
  "$id": "urn:matriculation-physics:question:1",
  "title": "Structured question v1",
  "description": "Canonical export schema. Database foreign keys, part relationships, approval requirements, and LaTeX are additionally validated by the server."
}
