          "teacherNotes": {
            "type": "string",
            "maxLength": 30000
          },
          "steps": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "markingCode": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9+._/-]{0,23}$"
                },
                "blocks": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "paragraph"
                          },
                          "text": {
                            "type": "string",
                            "maxLength": 30000
                          }
                        },
                        "required": [
                          "type",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "math"
                          },
                          "latex": {
                            "type": "string",
                            "maxLength": 30000
                          }
                        },
                        "required": [
                          "type",
                          "latex"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "image"
                          },
                          "assetId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          }
                        },
                        "required": [
                          "type",
                          "assetId"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "number": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "explanation": {
                  "type": "string",
                  "maxLength": 30000
                },
                "equationLatex": {
                  "type": "string",
                  "maxLength": 30000
                },
                "working": {
                  "type": "string",
                  "maxLength": 30000
                },
                "markingPoint": {
                  "type": "string",
                  "maxLength": 30000
                },
                "marks": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "order": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "number",
                "explanation",
                "equationLatex",
                "working",
                "markingPoint",
                "marks",
                "order"
              ],
              "additionalProperties": false
            }
          }
